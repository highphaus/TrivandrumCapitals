# ==============================================================================
# Trivandrum Capitals — Nodemailer Email Configuration
# ==============================================================================
# When you have your Gmail App Password ready:
# 1. Copy this file or add these variables to .env.local (and Vercel Project Settings)
# 2. How to create a Google App Password:
#    - Go to https://myaccount.google.com/security
#    - Enable 2-Step Verification if not already enabled
#    - Go to https://myaccount.google.com/apppasswords
#    - Name it "Trivandrum Capitals Website"
#    - Copy the generated 16-character password into EMAIL_PASS below

EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_character_app_password
EMAIL_TO=trivandrumcapitals@gmail.com

# Optional custom SMTP configuration (if not using Gmail service)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
